# ========================================================================
# SW Service Desk v1.0 - Production Environment Configuration
# Empresa: SW Cloud Solutions
# ========================================================================

# Servidor e Ambiente
NODE_ENV="production"
PORT=3000
APP_URL="https://servicedesk.swcloudsolutions.pt"

# Base de Dados (MySQL / MariaDB é a fonte de verdade em produção)
# Opções para DB_DIALECT: 'mysql' (produção) ou 'sqlite' (desenvolvimento/sandbox)
DB_DIALECT="sqlite"
DB_HOST="localhost"
DB_PORT=3306
DB_NAME="sw_servicedesk"
DB_USER="sw_user"
DB_PASSWORD="change_this_db_password_in_production"
DB_CONNECTION_LIMIT=20

# Segurança e Autenticação
JWT_SECRET="generate_a_minimum_64_character_cryptographically_secure_random_key_here"
JWT_EXPIRES_IN="8h"
SESSION_SECRET="generate_another_minimum_64_character_secure_random_key_here"
ENCRYPTION_KEY="32_byte_aes_key_for_secrets_2fa_encryption_key!"

# IA Privada para Técnicos (Google Gemini API)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Integração Microsoft 365 / Microsoft Teams
M365_ENABLED="false"
M365_TENANT_ID="00000000-0000-0000-0000-000000000000"
M365_CLIENT_ID="00000000-0000-0000-0000-000000000000"
M365_CLIENT_SECRET="m365_secret_key"
TEAMS_WEBHOOK_URL="https://swcloudsolutions.webhook.office.com/webhookb2/..."

# Notificações por Email (SMTP Corporativo)
SMTP_HOST="smtp.office365.com"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER="suporte@swcloudsolutions.pt"
SMTP_PASS="smtp_password"
SMTP_FROM="SW Service Desk <suporte@swcloudsolutions.pt>"

# Armazenamento e Backups
UPLOADS_DIR="./uploads"
BACKUP_DIR="./backups"
MAX_FILE_SIZE_MB=20
